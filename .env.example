# Discord bot token (Discord Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# Required only when the watched GitHub repository is private.
GITHUB_TOKEN=

# AI settings (ScoutCode endpoint; any OpenAI-compatible API also works)
AI_API_KEY=
AI_BASE_URL=https://scoutcode.dev/v1
AI_MODEL=minimax-m3.1-flash
# Tried automatically whenever the main model fails (rejected model, timeout, rate limit,
# outage) - same endpoint and API key. Never used on 401/403 (bad key).
AI_MODEL_FALLBACK=qwen3.8-27b
# Thinking depth: low | medium | high | xhigh | max. Leave empty for non-MiniMax models.
AI_REASONING_EFFORT=medium
# Total tokens the AI may use per UTC day, and seconds each user waits between requests.
# /botstats ai can change both at runtime.
AI_DAILY_TOKEN_LIMIT=1000000
AI_COOLDOWN_SECONDS=5
# Channel where every message is answered without pinging the bot (leave the default
# or set your own channel ID; mentions still work everywhere else).
AI_CHANNEL_ID=1568689660245450993
# /imagine: image model and daily image cap (one image per call). 0 = unlimited.
AI_IMAGE_MODEL=gpt-5-mini-image
AI_IMAGE_DAILY_LIMIT=50
# ScoutCode image generation uses the same endpoint and key as chat.
AI_IMAGE_BASE_URL=https://scoutcode.dev/v1
AI_IMAGE_ENDPOINT=/images/generations
AI_IMAGE_API_KEY=

# ScoutCode website / account linking
SCOUTCODE_SITE_URL=https://scoutcode.dev
# Shared secret for account linking (must match DISCORD_BOT_SECRET in scout/.env)
DISCORD_BOT_SECRET=

# Channel where new commits from https://github.com/itzremyx/Scoutbot are posted.
BOT_REPO_CHANNEL_ID=1568689855284777144
# Forum channel used by /suggest.
SUGGESTION_CHANNEL_ID=1566492469393227866

BOT_OWNER_ID=1561860035158736898
# Health alerts: bot owner DMs come for free; a webhook also works before login, and an
# external heartbeat URL (e.g. https://hc-ping.com/<uuid>) is pinged every 5 minutes.
ALERT_WEBHOOK_URL=
HEALTHCHECK_URL=
AI_VISION_MODEL=auto
AI_IMAGE_PER_USER_LIMIT=2
# Role given to every member who joins (a numeric Discord role id; leave empty to disable).
AUTO_ROLE_ID=1566953972290289764

# ScoutRadio: voice channel is renamed to "Radio | <track>" while playing (RADIO_RENAME_CHANNEL=false to keep the name).
RADIO_RENAME_CHANNEL=true
RADIO_CHANNEL_PREFIX=Radio
# Optional: YouTube cookie string or a cookies file for yt-dlp, for age-restricted or members-only links.
YOUTUBE_COOKIES=
YTDLP_COOKIES_FILE=
