# Discord bot token (Discord Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# AI settings (MiniMax by default, any OpenAI-compatible API also works)
AI_API_KEY=
AI_BASE_URL=https://api.minimax.io/v1
AI_MODEL=deepseek-v4.1-flash
# Tried automatically whenever the main model fails (rejected model, timeout, rate limit,
# outage) - same endpoint and API key. Never used on 401/403 (bad key).
AI_MODEL_FALLBACK=minimax-m3.1-flash
# Thinking depth: low | medium | high | xhigh | max. Leave empty for non-MiniMax models.
AI_REASONING_EFFORT=medium
# Total tokens the AI may use per UTC day, and seconds each user waits between requests.
# /botstats ai can change both at runtime.
AI_DAILY_TOKEN_LIMIT=1000000
AI_COOLDOWN_SECONDS=5
# Channel where every message is answered without pinging the bot (leave the default
# or set your own channel ID; mentions still work everywhere else).
AI_CHANNEL_ID=1566503029916700752
# /imagine: GPT-5 Image Mini and daily image cap (one image per call). 0 = unlimited.
AI_IMAGE_MODEL=openai/gpt-5-image-mini
AI_IMAGE_DAILY_LIMIT=50
# GPT-5 Image Mini uses OpenRouter's Image API. Create a separate key at openrouter.ai.
AI_IMAGE_BASE_URL=https://openrouter.ai/api/v1
AI_IMAGE_ENDPOINT=/images
AI_IMAGE_API_KEY=
# For MiniMax images instead, use AI_IMAGE_MODEL=image-01,
# AI_IMAGE_BASE_URL=https://api.minimax.io/v1 and AI_IMAGE_ENDPOINT=/image_generation.
